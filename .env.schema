# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Anything not prefixed with NEXT_PUBLIC_ is treated as sensitive (server-only, redacted)
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# ----------

# Injected automatically by Vercel at build time
# @optional @sensitive=false @type=enum(development, preview, production)
VERCEL_ENV=

# Current app environment - on Vercel this follows VERCEL_ENV
# @sensitive=false @type=enum(development, preview, production, test)
APP_ENV=fallback($VERCEL_ENV, development)

# Public base URL of the site, used for absolute links / metadata
# @type=url @example="https://example.com"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
